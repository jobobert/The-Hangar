<script src="{{=URL('static','js/mermaid.min.js')}}"></script>
<script src="{{=URL('static','js/mermaid-helpers.js', vars=dict(v=static_cachebust('js/mermaid-helpers.js')))}}"></script>

{{if mermaid:}}

<h3 class="export-h3">
    {{=controller_icon('diagram', 25)}}
    Wiring Diagram
</h3>
<div style="overflow-x:auto"><div id="graph-container" style=""></div></div>


<script>
    const mermaidGraph = `{{=XML(mermaid)}}`;
    const edgeStyles = {{=XML(edge_styles_json)}};

    renderMermaidInto(document.getElementById("graph-container"), mermaidGraph, { edgeStyles, maxWidth: '100%' });
</script>
{{else:}}
No Diagram
{{pass}}
