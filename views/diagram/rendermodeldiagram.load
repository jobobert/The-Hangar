<script src="{{=URL('static','js/viz-global.js')}}"></script>

{{if options == 'dashboard':}}

<div>
    {{=A("Edit", _href=URL('diagram', 'editmodeldiagram.html', args=model_id ), _class="btn btn-primary")}}

    <div style="overflow-x:auto"><div id="graph-container" class="col"></div></div>
</div>

{{else:}}
<div class="card">
    <div class="card-header">
        <h5 class="card-title" style="display: inline-block;">
            <span class="card-icon">{{=controller_icon('diagram', 25)}}</span>
            Wiring Diagram
        </h5>
        {{=A("Edit", _href=URL('diagram', 'editmodeldiagram.html', args=model_id ), _class="card-link th-new-link")}}

    </div>

    <div class="card-body">

        <div style="overflow-x:auto"><div id="graph-container" class="col"></div></div>

    </div>

</div>
{{pass}}


<script>
// IIFE, not top-level declarations: this fragment is injected into a host page
// that has its own script scope (views/model/index.html already declares a
// `container`), and a top-level const here would collide with it.
(function () {
    // Saved text is rendered verbatim — a legacy undirected `graph`/`--`
    // document and a generated `digraph`/`->` one both render as-is.
    const dotGraph = `{{=XML(dot)}}`;
    const container = document.getElementById("graph-container");

    if (dotGraph.trim()) {
        Viz.instance().then(viz => {
            const svg = viz.renderSVGElement(dotGraph);
            container.replaceChildren(svg);
        }).catch(err => {
            container.textContent = 'Diagram error: ' + err;
        });
    } else {
        container.textContent = 'No diagram yet.';
    }
})();
</script>
