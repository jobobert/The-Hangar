<div class="card model-card mb-2">
    <h4 class="card-header text-center">By State</h4>
    <div class="card-body">
        <table class="table table-sm">
            {{for c in counts:}}
            <tr>
                <td class="modelstate_bg_{{=c.model.modelstate}}"><a style="color: inherit;" href="{{=URL('default','index.html', vars=dict(fstates=c.model.modelstate.id))}}">{{=c.model.modelstate.name }}</a></td>
                <td class="text-right">{{=c._extra['COUNT("model"."id")'] }}</td>
            </tr>
            {{pass}}
        </table>
    </div>
</div>
